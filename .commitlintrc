{
  "$schema": "https://raw.githubusercontent.com/Zhengqbbb/cz-git/refs/tags/v1.13.2/docs/public/schema/cz-git.json",
  "prompt": {
    "scopes": [
      "deps",
      "config/fish",
      "config/ghostty",
      "config/git",
      "config/lazygit",
      "config/mise",
      "config/starship",
      "scripts",
      "misc"
    ],
    "useEmoji": false,
    "allowCustomScopes": false,
    "allowEmptyScopes": true
  }
}
